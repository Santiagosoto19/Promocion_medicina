# Copia este archivo a .env.local (o usa .env) y completa los valores. NUNCA subas estos archivos a git.

# Base de datos (Neon)
DATABASE_URL=                 # pooled (para la app)
DATABASE_URL_UNPOOLED=        # directa (para drizzle-kit)

# Auth del admin
AUTH_SECRET=                  # mínimo 32 caracteres: openssl rand -base64 48
ADMIN_EMAIL=
ADMIN_PASSWORD=               # solo para crear el admin; bórrala después

# Fotos (ImageKit, plan Forever Free)
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=         # solo servidor
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=   # https://ik.imagekit.io/tu_id

# Videos (Cloudinary)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Otros
CRON_SECRET=                  # openssl rand -hex 32
NEXT_PUBLIC_SITE_URL=http://localhost:3000
